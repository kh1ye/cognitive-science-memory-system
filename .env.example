# Copy this file to .env or export these variables before starting the backend.
# Shell environment variables override .env.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
# Optional: absolute path to the separate SQLite checkpoint/session database.
# CONVERSATION_DB_PATH=/absolute/path/conversations.db
# Optional compatibility aliases: OPENAI_API_KEY, OPENAI_BASE_URL
# Demo seeding stays disabled unless an explicit demo token is configured.
# COGNITIVE_MEMORY_DEMO_TOKEN=
